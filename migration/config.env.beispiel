# ---------------------------------------------------------------------------
# Konfiguration fuer die Bilder-Migration von GitHub auf den eigenen Webspace.
#
# Kopieren und ausfuellen:
#     cp migration/config.env.beispiel migration/config.env
#
# migration/config.env ist per .gitignore vom Repo ausgeschlossen und darf
# NICHT eingecheckt werden - da stehen Zugangsdaten drin.
# ---------------------------------------------------------------------------

# Unter welcher oeffentlichen Adresse sollen die Bilder spaeter erreichbar sein?
# Mit abschliessendem Schraegstrich. Aus dieser Basis + Dateiname entsteht die
# neue Bild-URL, die in Billbee eingetragen wird.
ZIEL_BASIS_URL="https://www.stegplattenversand.de/bilder/"

# Wie wird hochgeladen? ftps (empfohlen), sftp, ssh (rsync) oder ftp (unverschluesselt)
PROTOKOLL="ftps"

# Zugangsdaten des Webspace
HOST="ftp.stegplattenversand.de"
BENUTZER=""
PASSWORT=""

# Nur bei PROTOKOLL="ssh": Port und optionaler Schluessel
SSH_PORT="22"
SSH_SCHLUESSEL=""

# Zielverzeichnis auf dem Server - der Ordner, der unter ZIEL_BASIS_URL
# ausgeliefert wird. Beispiele: /httpdocs/bilder, /html/bilder, /www/bilder
ZIEL_VERZEICHNIS="/httpdocs/bilder"
